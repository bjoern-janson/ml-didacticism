{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjoern-janson/ml-didacticism/schema/annotation.schema.json",
  "title": "Mechanical Verse Annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "annotations"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,5}\\.[1-9][0-9]*\\.[1-9][0-9]*$"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "start", "end", "text"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "entity_mention",
              "location_mention",
              "temporal_marker",
              "action",
              "negation",
              "question",
              "command",
              "conditional",
              "causal_connective",
              "contrast_connective",
              "enumeration",
              "quotation"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
