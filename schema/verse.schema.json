{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjoern-janson/ml-didacticism/schema/verse.schema.json",
  "title": "KJV Verse Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "book",
    "chapter",
    "verse",
    "text_kjv",
    "text_normalized",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,5}\\.[1-9][0-9]*\\.[1-9][0-9]*$"
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "verse": {
      "type": "integer",
      "minimum": 1
    },
    "text_kjv": {
      "type": "string",
      "minLength": 1
    },
    "text_normalized": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "file",
        "json_pointer",
        "source_file_sha512",
        "text_kjv_sha256"
      ],
      "properties": {
        "repository": {
          "const": "renniemaharaj/kjv-bible"
        },
        "commit": {
          "const": "88723a44bb3e3f229a34f9cf11ce1b7acf971eee"
        },
        "tree": {
          "const": "df15756d8f2922f24c36ec86081d4d3244277619"
        },
        "file": {
          "type": "string",
          "pattern": "^.+\\.json$"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/[1-9][0-9]*/[1-9][0-9]*$"
        },
        "source_file_sha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "text_kjv_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
